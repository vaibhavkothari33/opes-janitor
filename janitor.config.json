{
  "version": 1,
  "_comment": "opes-janitor config. Paths use %VAR% tokens and FORWARD SLASHES - the engine normalizes them, which keeps this file free of JSON escape sequences. Set drives to 'auto' to scan every fixed disk. Copy this file to %APPDATA%/opes-janitor/config.json to keep your edits across updates.",

  "thresholds": {
    "warnBelowFreePercent": 15,
    "skipRunAboveFreePercent": 25
  },

  "drives": "auto",

  "logRetentionDays": 90,

  "_probes_comment": "Ask each tool where its cache really is, instead of assuming the default. A discovered path overrides the target's configured path and is allowlisted for that target only - it can never unlock a protectedPaths entry. Skip all of this with -NoProbe.",
  "probes": [
    { "targetId": "npm-cache",            "requires": "npm",   "command": "npm config get cache" },
    { "targetId": "yarn-cache",           "requires": "yarn",  "command": "yarn cache dir" },
    { "targetId": "pnpm-store",           "requires": "pnpm",  "command": "pnpm store path" },
    { "targetId": "pip-cache",            "requires": "pip",   "command": "pip cache dir" },
    { "targetId": "go-modcache",          "requires": "go",    "command": "go env GOMODCACHE" },
    { "targetId": "cargo-registry-cache", "requires": "cargo", "envVar": "CARGO_HOME", "suffix": "registry/cache" }
  ],

  "allowedPrefixes": [
    "%LOCALAPPDATA%",
    "%APPDATA%",
    "%USERPROFILE%/.cache",
    "%USERPROFILE%/.cargo",
    "%USERPROFILE%/.nuget",
    "%USERPROFILE%/.gradle",
    "%USERPROFILE%/go/pkg/mod",
    "%TEMP%",
    "C:/Windows/Temp",
    "C:/Windows/Logs/CBS",
    "C:/Windows/SoftwareDistribution/Download",
    "C:/Windows/SoftwareDistribution/DeliveryOptimization",
    "%PROGRAMDATA%/Microsoft/Windows/WER"
  ],

  "protectedPaths": [
    "%USERPROFILE%/Desktop",
    "%USERPROFILE%/Documents",
    "%USERPROFILE%/Pictures",
    "%USERPROFILE%/Videos",
    "%USERPROFILE%/Music",
    "%USERPROFILE%/Downloads",
    "%USERPROFILE%/OneDrive",
    "%USERPROFILE%/.ssh",
    "%USERPROFILE%/.aws",
    "%USERPROFILE%/.kube",
    "%USERPROFILE%/.config",
    "%USERPROFILE%/source",
    "%APPDATA%/Microsoft/Crypto",
    "%APPDATA%/Bitwarden",
    "%APPDATA%/KeePass"
  ],

  "targets": [
    {
      "id": "yarn-cache",
      "label": "Yarn package cache",
      "level": "safe",
      "enabled": true,
      "kind": "command",
      "requires": "yarn",
      "command": "yarn cache clean",
      "measure": "%LOCALAPPDATA%/Yarn"
    },
    {
      "id": "npm-cache",
      "label": "npm package cache",
      "level": "safe",
      "enabled": true,
      "kind": "command",
      "requires": "npm",
      "command": "npm cache clean --force",
      "measure": "%LOCALAPPDATA%/npm-cache"
    },
    {
      "id": "pnpm-store",
      "label": "pnpm content-addressable store",
      "level": "safe",
      "enabled": true,
      "kind": "command",
      "requires": "pnpm",
      "command": "pnpm store prune",
      "measure": "%LOCALAPPDATA%/pnpm-store"
    },
    {
      "id": "pip-cache",
      "label": "pip wheel cache",
      "level": "safe",
      "enabled": true,
      "kind": "command",
      "requires": "pip",
      "command": "pip cache purge",
      "measure": "%LOCALAPPDATA%/pip/Cache"
    },
    {
      "id": "uv-cache",
      "label": "uv package cache",
      "level": "safe",
      "enabled": true,
      "kind": "command",
      "requires": "uv",
      "command": "uv cache clean",
      "measure": "%LOCALAPPDATA%/uv"
    },
    {
      "id": "puppeteer-cache",
      "label": "Puppeteer downloaded browser builds",
      "level": "safe",
      "enabled": true,
      "kind": "pathContents",
      "path": "%USERPROFILE%/.cache/puppeteer",
      "measure": "%USERPROFILE%/.cache/puppeteer"
    },
    {
      "id": "user-temp",
      "label": "User temp folder (files older than 7d)",
      "level": "safe",
      "enabled": true,
      "kind": "pathContents",
      "path": "%LOCALAPPDATA%/Temp",
      "measure": "%LOCALAPPDATA%/Temp",
      "olderThanDays": 7,
      "note": "this is what %TEMP% points at - the Win+R trick, but age-filtered and skipping open files"
    },
    {
      "id": "windows-temp",
      "label": "Windows temp folder (files older than 7d)",
      "level": "safe",
      "enabled": true,
      "kind": "pathContents",
      "path": "C:/Windows/Temp",
      "measure": "C:/Windows/Temp",
      "olderThanDays": 7
    },
    {
      "id": "crash-dumps",
      "label": "Application crash dumps",
      "level": "safe",
      "enabled": true,
      "kind": "pathContents",
      "path": "%LOCALAPPDATA%/CrashDumps",
      "measure": "%LOCALAPPDATA%/CrashDumps",
      "note": "dumps from apps that crashed. Only useful while actively debugging one."
    },
    {
      "id": "wer-reports",
      "label": "Windows Error Reporting archive",
      "level": "safe",
      "enabled": true,
      "kind": "pathContents",
      "path": "%PROGRAMDATA%/Microsoft/Windows/WER/ReportArchive",
      "measure": "%PROGRAMDATA%/Microsoft/Windows/WER",
      "requiresAdmin": true
    },
    {
      "id": "recycle-bin",
      "label": "Recycle Bin",
      "level": "safe",
      "enabled": true,
      "kind": "builtin",
      "builtin": "recyclebin",
      "measure": "C:/$Recycle.Bin"
    },
    {
      "id": "go-modcache",
      "label": "Go module cache",
      "level": "deep",
      "enabled": true,
      "kind": "command",
      "requires": "go",
      "command": "go clean -modcache",
      "measure": "%USERPROFILE%/go/pkg/mod",
      "note": "deep only - forces a full re-download on the next build"
    },
    {
      "id": "cargo-registry-cache",
      "label": "Cargo registry download cache",
      "level": "deep",
      "enabled": true,
      "kind": "pathContents",
      "path": "%USERPROFILE%/.cargo/registry/cache",
      "measure": "%USERPROFILE%/.cargo/registry/cache"
    },
    {
      "id": "docker-prune",
      "label": "Docker unused images, containers, build cache",
      "level": "deep",
      "enabled": true,
      "kind": "command",
      "requires": "docker",
      "command": "docker system prune -af",
      "measure": "%LOCALAPPDATA%/Docker",
      "note": "does NOT pass --volumes - named volumes, where database data lives, are preserved"
    },
    {
      "id": "windows-update-cache",
      "label": "Downloaded Windows Update payloads",
      "level": "deep",
      "enabled": true,
      "kind": "pathContents",
      "path": "C:/Windows/SoftwareDistribution/Download",
      "measure": "C:/Windows/SoftwareDistribution/Download",
      "requiresAdmin": true,
      "note": "already-installed updates keep their payload here. Windows re-downloads if it ever needs them again."
    },
    {
      "id": "delivery-optimization",
      "label": "Delivery Optimization peer cache",
      "level": "deep",
      "enabled": true,
      "kind": "pathContents",
      "path": "C:/Windows/SoftwareDistribution/DeliveryOptimization",
      "measure": "C:/Windows/SoftwareDistribution/DeliveryOptimization",
      "requiresAdmin": true,
      "note": "update chunks cached to share with other PCs on the LAN. Regenerates."
    },
    {
      "id": "cbs-logs",
      "label": "Component Based Servicing logs (older than 30d)",
      "level": "deep",
      "enabled": true,
      "kind": "pathContents",
      "path": "C:/Windows/Logs/CBS",
      "measure": "C:/Windows/Logs/CBS",
      "requiresAdmin": true,
      "olderThanDays": 30
    },
    {
      "id": "dism-componentstore",
      "label": "Windows component store (superseded updates)",
      "level": "deep",
      "enabled": true,
      "kind": "builtin",
      "builtin": "dism",
      "requiresAdmin": true,
      "measure": "",
      "note": "IRREVERSIBLE - after this, already-installed Windows updates can no longer be uninstalled"
    },
    {
      "id": "REVIEW-huggingface",
      "label": "HuggingFace model cache",
      "level": "safe",
      "enabled": false,
      "kind": "pathContents",
      "path": "%USERPROFILE%/.cache/huggingface",
      "measure": "%USERPROFILE%/.cache/huggingface",
      "note": "REPORT ONLY. Inside allowedPrefixes, so setting enabled to true WILL delete it. Re-downloading large models is slow - opt in deliberately."
    },
    {
      "id": "REVIEW-thumbnail-cache",
      "label": "Explorer thumbnail and icon cache",
      "level": "safe",
      "enabled": false,
      "kind": "pathContents",
      "path": "%LOCALAPPDATA%/Microsoft/Windows/Explorer",
      "measure": "%LOCALAPPDATA%/Microsoft/Windows/Explorer",
      "note": "REPORT ONLY. Explorer holds these open so most deletes fail unless you kill explorer.exe first, and folder browsing is slower until it rebuilds. Rarely worth it."
    },
    {
      "id": "REVIEW-downloads",
      "label": "Downloads folder (items older than 90d)",
      "level": "safe",
      "enabled": false,
      "kind": "pathContents",
      "path": "%USERPROFILE%/Downloads",
      "measure": "%USERPROFILE%/Downloads",
      "olderThanDays": 90,
      "note": "REPORT ONLY, and listed in protectedPaths - the engine refuses it even if you set enabled to true. Let Windows Storage Sense age out Downloads instead."
    }
  ]
}
